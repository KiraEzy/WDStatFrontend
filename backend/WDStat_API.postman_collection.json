					"name": "Search - Filter by Date Range",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"All results are within date range\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.length > 0) {",
									"        var startDate = '1940-01-01';",
									"        var endDate = '1941-12-31';",
									"        jsonData.data.forEach(function(item) {",
									"            pm.expect(item.WDM_record_game_date).to.be.at.least(startDate);",
									"            pm.expect(item.WDM_record_game_date).to.be.at.most(endDate);",
									"        });",
									"    }",
									"});"
								],
								"type": "text/javascript"
