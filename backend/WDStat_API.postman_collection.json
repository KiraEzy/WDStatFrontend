{
	"info": {
		"_postman_id": "wdstat-api-collection",
		"name": "WDStat API - World Domination Metrics",
		"description": "Postman collection for testing WDStat Lambda endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
