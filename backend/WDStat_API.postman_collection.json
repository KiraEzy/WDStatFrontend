	"item": [
		{
			"name": "Create Record",
			"item": [
				{
					"name": "Create Record - Success",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response has success flag\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"});",
									"",
									"pm.test(\"Response contains data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.be.an('object');",
									"    pm.expect(jsonData.data.WDM_ID).to.exist;",
									"    pm.expect(jsonData.data.WDM_playing_as).to.exist;",
									"});",
									"",
									"pm.test(\"Response time is less than 2000ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);",
									"});",
									"",
									"// Save the created WDM_ID for later use",
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"last_created_wdm_id\", jsonData.data.WDM_ID);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"WDM_ID\": \"{{$randomInt}}\",\n  \"WDM_playing_as\": \"CAN\",\n  \"WDM_record_game_date\": \"1940-08-21\",\n  \"WDM_start_wd_game_date\": \"1939-12-01\"\n}"
						},
						"url": {
							"raw": "{{create_endpoint_url}}",
							"host": [
								"{{create_endpoint_url}}"
							]
						},
						"description": "Creates a new world domination metrics record. Uses random WDM_ID to avoid conflicts."
					},
					"response": []
				},
